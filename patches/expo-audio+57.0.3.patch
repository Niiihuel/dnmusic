+package expo.modules.audio
+
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import androidx.media3.common.MediaItem
+import androidx.media3.common.PlaybackException
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import kotlin.math.PI
+import kotlin.math.cos
+import kotlin.math.sin
+
+private const val FADE_TICK_MS = 20L
+private const val START_TIMEOUT_MS = 1_500L
+// The shortest requested fade is 250 ms. A scheduler tick can cross its cue
+// after the exact start, so its remaining media time can be slightly shorter.
+private const val MIN_EFFECTIVE_FADE_MS = 50L
+
+/** Volume envelopes are applied to ExoPlayer.volume every 20 ms. Temporary
+ * EQ and filter effects run separately on decoded PCM in the audio renderer. */
+internal fun validCrossfadeCurve(points: List<CrossfadeVolumePoint>?, incoming: Boolean): Boolean {
+  if (points == null) return true
+  if (points.size !in 2..16) return false
+  if (kotlin.math.abs(points.first().t) > 0.000001 || kotlin.math.abs(points.last().t - 1.0) > 0.000001) return false
+  if (kotlin.math.abs(points.first().value - (if (incoming) 0.0 else 1.0)) > 0.000001 ||
+    kotlin.math.abs(points.last().value - (if (incoming) 1.0 else 0.0)) > 0.000001) return false
+  var previous = -1.0
+  for (point in points) {
+    if (!point.t.isFinite() || !point.value.isFinite() || point.t <= previous ||
+      point.t !in 0.0..1.0 || point.value !in 0.0..1.0) return false
+    previous = point.t
+  }
+  return true
+}
+
+internal fun crossfadeValue(
+  points: List<CrossfadeVolumePoint>?, incoming: Boolean, law: CrossfadeVolumeLaw, position: Double
+): Float {
+  val t = position.coerceIn(0.0, 1.0)
+  if (points != null) {
+    for (index in 1 until points.size) {
+      val next = points[index]
+      if (t <= next.t) {
+        val previous = points[index - 1]
+        return (previous.value + (next.value - previous.value) *
+          (t - previous.t) / (next.t - previous.t)).toFloat()
+      }
+    }
+    return points.last().value.toFloat()
+  }
+  return when (law) {
+    CrossfadeVolumeLaw.EQUAL_POWER -> if (incoming) sin(t * PI / 2).toFloat() else cos(t * PI / 2).toFloat()
+    CrossfadeVolumeLaw.LINEAR -> if (incoming) t.toFloat() else (1 - t).toFloat()
+  }
+}
+
+/** Two ExoPlayers sharing one transition. The main-looper poll checks actual
+ * media positions, so a paused or buffered outgoing deck cannot advance the
+ * fade from elapsed wall time. The next deck stays at zero gain until ready. */
+@UnstableApi
+internal class AudioCrossfade(
+  private val outgoing: AudioPlayer,
+  private val incoming: AudioPlayer,
+  private val requestedStartMs: Long,
+  private val requestedDurationMs: Long,
+  private val options: CrossfadeOptions
+) {
+  private val handler = Handler(Looper.getMainLooper())
+  private val outgoingItem: MediaItem? = outgoing.ref.currentMediaItem
+  private val incomingItem: MediaItem? = incoming.ref.currentMediaItem
+  private var started = false
+  private var fading = false
+  private var closed = false
+  private var pausedIncomingForOutgoing = false
+  private var startedAtElapsedMs = 0L
+  private var fadeStartMs = 0L
+  private var fadeDurationMs = 0L
+
+  private val tick = object : Runnable {
+    override fun run() {
+      update()
+    }
+  }
+
+  private val listener = object : Player.Listener {
+    override fun onPositionDiscontinuity(
+      oldPosition: Player.PositionInfo, newPosition: Player.PositionInfo, reason: Int
+    ) {
+      if (reason == Player.DISCONTINUITY_REASON_SEEK) cancel()
+    }
+
+    override fun onMediaItemTransition(mediaItem: MediaItem?, reason: Int) {
+      cancel()
+    }
+
+    override fun onPlayerError(error: PlaybackException) {
+      cancel()
+    }
+
+    override fun onPlaybackStateChanged(playbackState: Int) {
+      if (playbackState == Player.STATE_IDLE || playbackState == Player.STATE_ENDED) {
+        if (outgoing.ref.playbackState == Player.STATE_ENDED && this@AudioCrossfade.onOutgoingEnded()) return
+        cancel()
+      } else {
+        handler.removeCallbacks(tick)
+        handler.post(tick)
+      }
+    }
+
+    override fun onIsPlayingChanged(isPlaying: Boolean) {
+      handler.removeCallbacks(tick)
+      handler.post(tick)
+    }
+  }
+
+  fun arm() {
+    if (closed) return
+    if (hasTransitionEffects(options)) {
+      val eq = options.eqSettings?.takeIf { it.enabled }
+      val filter = options.filterSettings?.takeIf { it.enabled }
+      outgoing.setTransitionEffect(if (eq != null || filter?.out != null) TransitionDeckEffect(
+        eq?.out, filter?.out, requestedStartMs / 1000.0, requestedDurationMs / 1000.0
+      ) else null)
+      incoming.setTransitionEffect(if (eq != null || filter?.`in` != null) TransitionDeckEffect(
+        eq?.`in`, filter?.`in`, options.toStartSeconds ?: 0.0, requestedDurationMs / 1000.0
+      ) else null)
+    }
+    incoming.setCrossfadeGain(0f)
+    outgoing.ref.addListener(listener)
+    incoming.ref.addListener(listener)
+    handler.post(tick)
+  }
+
+  private fun sameSources(): Boolean =
+    outgoing.ref.currentMediaItem == outgoingItem && incoming.ref.currentMediaItem == incomingItem &&
+      outgoing.ref.repeatMode != Player.REPEAT_MODE_ONE && incoming.ref.repeatMode != Player.REPEAT_MODE_ONE
+
+  private fun scheduleNext() {
+    if (!closed) handler.postDelayed(tick, if (outgoing.ref.isPlaying) FADE_TICK_MS else 100L)
+  }
+
+  private fun update() {
+    if (closed) return
+    if (!sameSources()) { cancel(); return }
+    if (hasTransitionEffects(options) &&
+      (!outgoing.supportsTransitionEffects || !incoming.supportsTransitionEffects)) { cancel(); return }
+    val outgoingPosition = outgoing.ref.currentPosition
+    if (!started) {
+      if (!outgoing.ref.isPlaying) { scheduleNext(); return }
+      if (outgoingPosition < requestedStartMs) { scheduleNext(); return }
+      if (outgoing.ref.duration - outgoingPosition < MIN_EFFECTIVE_FADE_MS ||
+        incoming.ref.playbackState != Player.STATE_READY) { cancel(); return }
+      started = true
+      startedAtElapsedMs = SystemClock.elapsedRealtime()
+      incoming.ref.play()
+    }
+
+    if (!outgoing.ref.isPlaying) {
+      pausedIncomingForOutgoing = true
+      if (incoming.ref.isPlaying) incoming.ref.pause()
+      scheduleNext()
+      return
+    }
+    if (pausedIncomingForOutgoing) {
+      pausedIncomingForOutgoing = false
+      startedAtElapsedMs = SystemClock.elapsedRealtime()
+      incoming.ref.play()
+    }
+
+    if (!fading) {
+      if (!incoming.ref.isPlaying) {
+        if (SystemClock.elapsedRealtime() - startedAtElapsedMs > START_TIMEOUT_MS ||
+          outgoing.ref.duration - outgoingPosition < MIN_EFFECTIVE_FADE_MS) { cancel(); return }
+        scheduleNext()
+        return
+      }
+      fadeStartMs = outgoingPosition
+      fadeDurationMs = minOf(requestedDurationMs,
+        outgoing.ref.duration - outgoingPosition,
+        incoming.ref.duration - incoming.ref.currentPosition)
+      if (fadeDurationMs < MIN_EFFECTIVE_FADE_MS) { cancel(); return }
+      fading = true
+    } else if (!incoming.ref.isPlaying) {
+      // Do not advance the old deck into silence while the new source buffers.
+      cancel()
+      return
+    }
+
+    val progress = ((outgoingPosition - fadeStartMs).toDouble() / fadeDurationMs).coerceIn(0.0, 1.0)
+    outgoing.setCrossfadeGain(crossfadeValue(options.volumeOut, false, options.volumeLaw, progress))
+    incoming.setCrossfadeGain(crossfadeValue(options.volumeIn, true, options.volumeLaw, progress))
+    if (progress >= 1.0 || outgoing.ref.playbackState == Player.STATE_ENDED) complete()
+    else scheduleNext()
+  }
+
+  /** Called from AudioPlayer's end callback if the 20 ms tick loses the race. */
+  fun onOutgoingEnded(): Boolean {
+    if (closed || !fading || !incoming.ref.isPlaying) return false
+    complete()
+    return true
+  }
+
+  private fun complete() {
+    if (closed) return
+    close()
+    outgoing.markCrossfadeCompleted()
+    outgoing.ref.pause()
+    outgoing.setCrossfadeGain(1f)
+    incoming.setCrossfadeGain(1f)
+  }
+
+  fun cancel() {
+    if (closed) return
+    close()
+    if (started) incoming.ref.pause()
+    outgoing.setCrossfadeGain(1f)
+    incoming.setCrossfadeGain(1f)
+  }
+
+  private fun close() {
+    if (closed) return
+    closed = true
+    outgoing.setTransitionEffect(null)
+    incoming.setTransitionEffect(null)
+    handler.removeCallbacks(tick)
+    outgoing.outgoingCrossfade = null
+    incoming.incomingCrossfade = null
+    outgoing.ref.removeListener(listener)
+    incoming.ref.removeListener(listener)
+  }
+}
