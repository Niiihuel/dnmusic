+/** A temporary effect for one deck. The renderer thread owns all mutable DSP
+ * state; the main thread only swaps an immutable configuration. */
+internal data class TransitionDeckEffect(
+  val eq: CrossfadeThreeBand?,
+  val filter: CrossfadeTransitionFilterDeck?,
+  val startSeconds: Double,
+  val durationSeconds: Double
+)
+
+internal fun validTransitionEffectCurve(
+  points: List<CrossfadeVolumePoint>, minValue: Double, maxValue: Double
+): Boolean {
+  if (points.size !in 2..16 || abs(points.first().t) > 0.000001 ||
+    abs(points.last().t - 1.0) > 0.000001) return false
+  var previous = -1.0
+  for (point in points) {
+    if (!point.t.isFinite() || !point.value.isFinite() || point.t <= previous ||
+      point.t !in 0.0..1.0 || point.value !in minValue..maxValue) return false
+    previous = point.t
+  }
+  return true
+}
+
+internal fun validTransitionEffects(options: CrossfadeOptions): Boolean {
+  options.eqSettings?.let { eq ->
+    if (eq.version != 1 || listOf(eq.out, eq.`in`).any { bands ->
+        listOf(bands.low, bands.mid, bands.high).any { !validTransitionEffectCurve(it, -24.0, 24.0) }
+      }) return false
+  }
+  options.filterSettings?.let { filter ->
+    if (filter.version != 1 || listOfNotNull(filter.out, filter.`in`).any {
+        !validTransitionEffectCurve(it.cutoff, 20.0, 20_000.0)
+      }) return false
+  }
+  return true
+}
+
+internal fun hasTransitionEffects(options: CrossfadeOptions): Boolean =
+  options.eqSettings?.enabled == true || options.filterSettings?.enabled == true
+
+private data class Biquad(
+  val b0: Double = 1.0, val b1: Double = 0.0, val b2: Double = 0.0,
+  val a1: Double = 0.0, val a2: Double = 0.0
+)
+
+private class BiquadState {
+  var x1 = 0.0
+  var x2 = 0.0
+  var y1 = 0.0
+  var y2 = 0.0
+
+  fun process(input: Double, c: Biquad): Double {
+    val output = c.b0 * input + c.b1 * x1 + c.b2 * x2 - c.a1 * y1 - c.a2 * y2
+    x2 = x1; x1 = input; y2 = y1; y1 = output
+    return output
+  }
+
+  fun reset() { x1 = 0.0; x2 = 0.0; y1 = 0.0; y2 = 0.0 }
+}
+
+private fun normalize(b0: Double, b1: Double, b2: Double,
+                      a0: Double, a1: Double, a2: Double): Biquad =
+  if (!a0.isFinite() || a0 <= 1e-12) Biquad()
+  else Biquad(b0 / a0, b1 / a0, b2 / a0, a1 / a0, a2 / a0)
+
+private fun shelf(high: Boolean, frequency: Double, sampleRate: Double, gainDb: Double): Biquad {
+  if (abs(gainDb) < 0.0001) return Biquad()
+  val f = frequency.coerceIn(20.0, sampleRate * 0.45)
+  val a = 10.0.pow(gainDb / 40.0)
+  val omega = 2.0 * PI * f / sampleRate
+  val cosine = cos(omega)
+  val alpha = sin(omega) / sqrt(2.0)
+  val beta = 2.0 * sqrt(a) * alpha
+  return if (high) normalize(
+    a * ((a + 1) + (a - 1) * cosine + beta),
+    -2 * a * ((a - 1) + (a + 1) * cosine),
+    a * ((a + 1) + (a - 1) * cosine - beta),
+    (a + 1) - (a - 1) * cosine + beta,
+    2 * ((a - 1) - (a + 1) * cosine),
+    (a + 1) - (a - 1) * cosine - beta
+  ) else normalize(
+    a * ((a + 1) - (a - 1) * cosine + beta),
+    2 * a * ((a - 1) - (a + 1) * cosine),
+    a * ((a + 1) - (a - 1) * cosine - beta),
+    (a + 1) + (a - 1) * cosine + beta,
+    -2 * ((a - 1) + (a + 1) * cosine),
+    (a + 1) + (a - 1) * cosine - beta
+  )
+}
+
+private fun peaking(frequency: Double, sampleRate: Double, gainDb: Double): Biquad {
+  if (abs(gainDb) < 0.0001 || frequency >= sampleRate * 0.49) return Biquad()
+  val a = 10.0.pow(gainDb / 40.0)
+  val omega = 2.0 * PI * frequency / sampleRate
+  val alpha = sin(omega) / (2.0 * sqrt(2.0))
+  val cosine = cos(omega)
+  val a0 = 1.0 + alpha / a
+  return normalize(1.0 + alpha * a, -2.0 * cosine, 1.0 - alpha * a,
+    a0, -2.0 * cosine, 1.0 - alpha / a)
+}
+
+private fun filter(kind: CrossfadeTransitionFilterKind?, cutoff: Double, sampleRate: Double): Biquad {
+  if (kind == null) return Biquad()
+  val f = cutoff.coerceIn(20.0, sampleRate * 0.45)
+  val omega = 2.0 * PI * f / sampleRate
+  val cosine = cos(omega)
+  val alpha = sin(omega) / sqrt(2.0)
+  val low = kind == CrossfadeTransitionFilterKind.LOWPASS
+  val edge = if (low) 1.0 - cosine else 1.0 + cosine
+  return normalize(edge / 2.0, if (low) edge else -edge, edge / 2.0,
+    1.0 + alpha, -2.0 * cosine, 1.0 - alpha)
+}
+
+private fun curveValue(points: List<CrossfadeVolumePoint>, t: Double): Double {
+  if (t <= points.first().t) return points.first().value
+  for (index in 1 until points.size) {
+    val next = points[index]
+    if (t <= next.t) {
+      val previous = points[index - 1]
+      return previous.value + (next.value - previous.value) *
+        (t - previous.t) / (next.t - previous.t)
+    }
+  }
+  return points.last().value
+}
