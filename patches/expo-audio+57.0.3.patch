+/** Pure per-frame DSP, separate from Android buffers so coefficients and
+ * boundary behaviour can be tested with generated PCM. */
+internal class TransitionDsp(private val sampleRate: Int, channels: Int) {
+  private val state = Array(channels) { Array(4) { BiquadState() } }
+  private val coefficients = Array(4) { Biquad() }
+  private val probeCos = DoubleArray(32)
+  private val probeSin = DoubleArray(32)
+  private val probeCos2 = DoubleArray(32)
+  private val probeSin2 = DoubleArray(32)
+  private var config: TransitionDeckEffect? = null
+  private var step = 0L
+  private var preamp = 1.0
+  private var targetPreamp = 1.0
+  private var wet = 0.0
+
+  init {
+    for (probe in 0 until 32) {
+      val frequency = 20.0 * (sampleRate * 0.45 / 20.0).pow(probe / 31.0)
+      val omega = 2.0 * PI * frequency / sampleRate
+      probeCos[probe] = cos(omega); probeSin[probe] = sin(omega)
+      probeCos2[probe] = cos(2.0 * omega); probeSin2[probe] = sin(2.0 * omega)
+    }
+  }
+
+  fun setConfig(next: TransitionDeckEffect?) {
+    if (config === next) return
+    config = next
+    step = 0L
+    preamp = 1.0
+    targetPreamp = 1.0
+    for (channel in state) for (band in channel) band.reset()
+  }
+
+  fun beginFrame(mediaTimeSeconds: Double) {
+    val active = config ?: return
+    val elapsed = mediaTimeSeconds - active.startSeconds
+    wet = (min(elapsed, active.durationSeconds - elapsed) / 0.015).coerceIn(0.0, 1.0)
+    if (wet <= 0.0) return
+    val t = (elapsed / active.durationSeconds).coerceIn(0.0, 1.0)
+    if (step++ % 32L == 0L) {
+      coefficients[0] = shelf(false, 200.0, sampleRate.toDouble(), active.eq?.let { curveValue(it.low, t) } ?: 0.0)
+      coefficients[1] = peaking(1000.0, sampleRate.toDouble(), active.eq?.let { curveValue(it.mid, t) } ?: 0.0)
+      coefficients[2] = shelf(true, 5000.0, sampleRate.toDouble(), active.eq?.let { curveValue(it.high, t) } ?: 0.0)
+      coefficients[3] = filter(active.filter?.kind,
+        active.filter?.let { curveValue(it.cutoff, t) } ?: 20_000.0, sampleRate.toDouble())
+      var peakSquared = 1.0
+      for (probe in 0 until 32) {
+        var response = 1.0
+        for (c in coefficients) {
+          val nr = c.b0 + c.b1 * probeCos[probe] + c.b2 * probeCos2[probe]
+          val ni = c.b1 * probeSin[probe] + c.b2 * probeSin2[probe]
+          val dr = 1.0 + c.a1 * probeCos[probe] + c.a2 * probeCos2[probe]
+          val di = c.a1 * probeSin[probe] + c.a2 * probeSin2[probe]
+          response *= (nr * nr + ni * ni) / max(1e-24, dr * dr + di * di)
+        }
+        peakSquared = max(peakSquared, response)
+      }
+      targetPreamp = if (peakSquared > 1.0001) 10.0.pow(-0.5 / 20.0) / sqrt(peakSquared) else 1.0
+      if (step == 1L || targetPreamp < preamp) preamp = targetPreamp
+    }
+    if (preamp < targetPreamp) preamp += (targetPreamp - preamp) * 0.00025
+  }
+
+  fun processSample(channel: Int, input: Float): Float {
+    if (config == null || !input.isFinite()) return if (input.isFinite()) input else 0f
+    if (wet <= 0.0) return input
+    var value = input * preamp
+    for (band in 0..3) {
+      value = state[channel][band].process(value, coefficients[band])
+    }
+    if (!value.isFinite()) {
+      for (band in state[channel]) band.reset()
+      return 0f
+    }
+    return (input + (value - input) * wet).coerceIn(-1.0, 1.0).toFloat()
+  }
+}
