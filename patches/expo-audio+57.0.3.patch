diff --git a/node_modules/expo-audio/ios/DNCrossfadeDSP.h b/node_modules/expo-audio/ios/DNCrossfadeDSP.h
new file mode 100644
index 0000000..8520ed0
--- /dev/null
+++ b/node_modules/expo-audio/ios/DNCrossfadeDSP.h
@@ -0,0 +1,46 @@
+#ifndef DN_CROSSFADE_DSP_H
+#define DN_CROSSFADE_DSP_H
+
+#include <math.h>
+
+#define DN_CROSSFADE_MAX_POINTS 16
+
+typedef struct DNCrossfadeCurve {
+  int count;
+  double times[DN_CROSSFADE_MAX_POINTS];
+  double values[DN_CROSSFADE_MAX_POINTS];
+} DNCrossfadeCurve;
+
+static inline double DNCrossfadeCurveValue(const DNCrossfadeCurve *curve, double position) {
+  if (!curve || curve->count < 2 || curve->count > DN_CROSSFADE_MAX_POINTS) return NAN;
+  for (int index = 1; index < curve->count; index++) {
+    if (position <= curve->times[index]) {
+      const double span = curve->times[index] - curve->times[index - 1];
+      if (span <= 0) return NAN;
+      const double local = (position - curve->times[index - 1]) / span;
+      return curve->values[index - 1] + local * (curve->values[index] - curve->values[index - 1]);
+    }
+  }
+  return curve->values[curve->count - 1];
+}
+
+// Media-time linear envelope. Caller multiplies this with processed PCM, so
+// AVPlayer.volume (user volume and track headroom) is never overwritten.
+static inline float DNCrossfadeGain(int mode, int equalPower, const DNCrossfadeCurve *curve,
+                                    double mediaTime, double start, double duration) {
+  if (mode == 2) return 0.0f; // incoming deck waiting for the overlap
+  if (mode != 1 && mode != 3) return 1.0f;
+  if (!isfinite(mediaTime) || !isfinite(start) ||
+      !isfinite(duration) || duration <= 0) return mode == 3 ? 0.0f : 1.0f;
+  double position = (mediaTime - start) / duration;
+  position = fmax(0.0, fmin(1.0, position));
+  const double custom = DNCrossfadeCurveValue(curve, position);
+  if (isfinite(custom)) return (float)fmax(0.0, fmin(1.0, custom));
+  if (equalPower) {
+    const double angle = position * 1.5707963267948966;
+    return mode == 1 ? (float)cos(angle) : (float)sin(angle);
+  }
+  return mode == 1 ? (float)(1.0 - position) : (float)position;
+}
+
+#endif
diff --git a/node_modules/expo-audio/ios/DNEqualizerDSP.h b/node_modules/expo-audio/ios/DNEqualizerDSP.h
new file mode 100644
index 0000000..5c59b84
--- /dev/null
+++ b/node_modules/expo-audio/ios/DNEqualizerDSP.h
@@ -0,0 +1,108 @@
+// dnmusic: portable DSP, exercised with generated signals in tests/fixtures.
+// The audio callback owns this state. No allocation, locks or Objective-C here.
+#ifndef DN_EQUALIZER_DSP_H
+#define DN_EQUALIZER_DSP_H
+#include <math.h>
+#include <stdbool.h>
+#include <string.h>
+
+#define DN_EQ_BANDS 10
+#define DN_EQ_MAX_CHANNELS 8
+#define DN_EQ_PI 3.14159265358979323846
+static const double DNEQFrequencies[DN_EQ_BANDS] = {31, 62, 125, 250, 500, 1000, 2000, 4000, 8000, 16000};
+
+typedef struct { double b0, b1, b2, a1, a2; } DNEQCoefficients;
+typedef struct { double x1, x2, y1, y2; } DNEQState;
+typedef struct {
+  double sampleRate, smoothing, gainSmoothing, preamp, targetPreamp;
+  double gains[DN_EQ_BANDS], targets[DN_EQ_BANDS];
+  DNEQCoefficients coefficients[DN_EQ_BANDS];
+  DNEQState channels[DN_EQ_MAX_CHANNELS][DN_EQ_BANDS];
+  unsigned int step;
+  bool bypass;
+} DNEqualizerDSP;
+
+static inline DNEQCoefficients DNEQMakePeaking(double frequency, double sampleRate, double gainDB) {
+  if (!isfinite(gainDB) || fabs(gainDB) < 0.0001 || frequency >= sampleRate * 0.49) {
+    return (DNEQCoefficients){1, 0, 0, 0, 0};
+  }
+  const double a = pow(10.0, gainDB / 40.0);
+  const double omega = 2.0 * DN_EQ_PI * frequency / sampleRate;
+  const double alpha = sin(omega) / (2.0 * sqrt(2.0));
+  const double cosine = cos(omega), a0 = 1.0 + alpha / a;
+  return (DNEQCoefficients){(1.0 + alpha * a) / a0, -2.0 * cosine / a0,
+    (1.0 - alpha * a) / a0, -2.0 * cosine / a0, (1.0 - alpha / a) / a0};
+}
+
+static inline void DNEQPrepare(DNEqualizerDSP *eq, double sampleRate) {
+  memset(eq, 0, sizeof(*eq));
+  eq->sampleRate = isfinite(sampleRate) && sampleRate > 0 ? sampleRate : 48000;
+  eq->smoothing = 1.0 - exp(-32.0 / (0.020 * eq->sampleRate));
+  eq->gainSmoothing = 1.0 - exp(-1.0 / (0.020 * eq->sampleRate));
+  eq->preamp = eq->targetPreamp = 1.0;
+  eq->bypass = true;
+  for (int band = 0; band < DN_EQ_BANDS; band++) eq->coefficients[band].b0 = 1;
+}
+
+static inline double DNEQResponseSquared(DNEQCoefficients c, double omega) {
+  const double real = cos(omega), imag = sin(omega), real2 = cos(2 * omega), imag2 = sin(2 * omega);
+  const double nr = c.b0 + c.b1 * real + c.b2 * real2, ni = c.b1 * imag + c.b2 * imag2;
+  const double dr = 1 + c.a1 * real + c.a2 * real2, di = c.a1 * imag + c.a2 * imag2;
+  return (nr * nr + ni * ni) / fmax(1e-24, dr * dr + di * di);
+}
+
+static inline void DNEQSetTarget(DNEqualizerDSP *eq, bool enabled, const float gains[DN_EQ_BANDS]) {
+  DNEQCoefficients target[DN_EQ_BANDS];
+  for (int band = 0; band < DN_EQ_BANDS; band++) {
+    const double value = enabled && isfinite(gains[band]) ? fmax(-12, fmin(12, gains[band])) : 0;
+    eq->targets[band] = DNEQFrequencies[band] < eq->sampleRate * 0.49 ? value : 0;
+    target[band] = DNEQMakePeaking(DNEQFrequencies[band], eq->sampleRate, eq->targets[band]);
+  }
+  // Evaluate the combined response, not just max(band): adjacent peaks overlap.
+  double peak = 1;
+  for (int bin = 0; bin <= 256; bin++) {
+    const double frequency = 10 * pow(eq->sampleRate * 0.049, bin / 256.0);
+    const double omega = 2 * DN_EQ_PI * frequency / eq->sampleRate;
+    double response = 1;
+    for (int band = 0; band < DN_EQ_BANDS; band++) response *= DNEQResponseSquared(target[band], omega);
+    peak = fmax(peak, response);
+  }
+  eq->targetPreamp = peak > 1.0001 ? pow(10, -0.5 / 20.0) / sqrt(peak) : 1;
+  eq->bypass = false;
+  eq->step = 0;
+}
+
+static inline void DNEQBeginFrame(DNEqualizerDSP *eq) {
+  if (eq->bypass) return;
+  eq->preamp += (eq->targetPreamp - eq->preamp) * eq->gainSmoothing;
+  if (fabs(eq->targetPreamp - eq->preamp) < 1e-7) eq->preamp = eq->targetPreamp;
+  if (eq->step++ % 32 != 0) return;
+  bool flat = eq->preamp == 1 && eq->targetPreamp == 1;
+  for (int band = 0; band < DN_EQ_BANDS; band++) {
+    const double previous = eq->gains[band];
+    eq->gains[band] += (eq->targets[band] - eq->gains[band]) * eq->smoothing;
+    if (fabs(eq->targets[band] - eq->gains[band]) < 0.001) eq->gains[band] = eq->targets[band];
+    flat = flat && eq->gains[band] == 0;
+    if (previous != eq->gains[band]) eq->coefficients[band] = DNEQMakePeaking(DNEQFrequencies[band], eq->sampleRate, eq->gains[band]);
+  }
+  // Never reset filter history when a finger moves. Only clear after a smooth
+  // return to identity, or in prepare when the source/format really changes.
+  if (flat) { eq->bypass = true; memset(eq->channels, 0, sizeof(eq->channels)); }
+}
+
+static inline float DNEQProcessSample(DNEqualizerDSP *eq, unsigned int channel, float input) {
+  if (!isfinite(input)) return 0;
+  if (eq->bypass || channel >= DN_EQ_MAX_CHANNELS) return input;
+  double value = input * eq->preamp;
+  for (int band = 0; band < DN_EQ_BANDS; band++) {
+    DNEQCoefficients c = eq->coefficients[band];
+    DNEQState *s = &eq->channels[channel][band];
+    const double output = c.b0 * value + c.b1 * s->x1 + c.b2 * s->x2 - c.a1 * s->y1 - c.a2 * s->y2;
+    s->x2 = s->x1; s->x1 = value; s->y2 = s->y1; s->y1 = output;
+    value = output;
+  }
+  if (!isfinite(value)) { memset(eq->channels[channel], 0, sizeof(eq->channels[channel])); return 0; }
+  // Last-resort peak guard; response-based headroom prevents normal clipping.
+  return (float)fmax(-1, fmin(1, value));
+}
+#endif
diff --git a/node_modules/expo-audio/ios/DNTransitionDSP.h b/node_modules/expo-audio/ios/DNTransitionDSP.h
new file mode 100644
index 0000000..b81c793
--- /dev/null
+++ b/node_modules/expo-audio/ios/DNTransitionDSP.h
@@ -0,0 +1,179 @@
+// A temporary three-band DJ EQ and resonant-free low/high-pass sweep.
+// This state belongs to one audio render tap and runs only during overlap.
+#ifndef DN_TRANSITION_DSP_H
+#define DN_TRANSITION_DSP_H
+
+#include "DNCrossfadeDSP.h"
+#include "DNEqualizerDSP.h"
+
+#define DN_TRANSITION_BANDS 3
+#define DN_TRANSITION_FILTER_INDEX 3
+#define DN_TRANSITION_PROBES 32
+
+typedef struct {
+  bool eqEnabled;
+  DNCrossfadeCurve eq[DN_TRANSITION_BANDS]; // low shelf, mid bell, high shelf
+  int filterKind; // 0 bypass, 1 low-pass, 2 high-pass
+  DNCrossfadeCurve cutoff;
+} DNTransitionSettings;
+
+typedef struct {
+  double sampleRate;
+  double probeCos[DN_TRANSITION_PROBES], probeSin[DN_TRANSITION_PROBES];
+  double probeCos2[DN_TRANSITION_PROBES], probeSin2[DN_TRANSITION_PROBES];
+  double preamp;
+  double targetPreamp;
+  double wet;
+  DNEQCoefficients coefficients[DN_TRANSITION_BANDS + 1];
+  DNEQState channels[DN_EQ_MAX_CHANNELS][DN_TRANSITION_BANDS + 1];
+  DNTransitionSettings settings;
+  unsigned int step;
+  bool active;
+} DNTransitionDSP;
+
+static inline DNEQCoefficients DNTIdentity(void) {
+  return (DNEQCoefficients){1, 0, 0, 0, 0};
+}
+
+static inline DNEQCoefficients DNTNormalize(double b0, double b1, double b2,
+                                             double a0, double a1, double a2) {
+  if (!isfinite(a0) || a0 <= 1e-12) return DNTIdentity();
+  return (DNEQCoefficients){b0 / a0, b1 / a0, b2 / a0, a1 / a0, a2 / a0};
+}
+
+// RBJ shelf, S=1. Low and high are broad tone controls; mid uses Q=sqrt(2).
+static inline DNEQCoefficients DNTShelf(bool high, double frequency,
+                                         double sampleRate, double gainDb) {
+  if (!isfinite(gainDb) || fabs(gainDb) < 0.0001) return DNTIdentity();
+  frequency = fmax(20, fmin(sampleRate * 0.45, frequency));
+  const double a = pow(10, gainDb / 40), omega = 2 * DN_EQ_PI * frequency / sampleRate;
+  const double cosine = cos(omega), alpha = sin(omega) / sqrt(2);
+  const double beta = 2 * sqrt(a) * alpha;
+  if (high) return DNTNormalize(
+    a * ((a + 1) + (a - 1) * cosine + beta),
+    -2 * a * ((a - 1) + (a + 1) * cosine),
+    a * ((a + 1) + (a - 1) * cosine - beta),
+    (a + 1) - (a - 1) * cosine + beta,
+    2 * ((a - 1) - (a + 1) * cosine),
+    (a + 1) - (a - 1) * cosine - beta);
+  return DNTNormalize(
+    a * ((a + 1) - (a - 1) * cosine + beta),
+    2 * a * ((a - 1) - (a + 1) * cosine),
+    a * ((a + 1) - (a - 1) * cosine - beta),
+    (a + 1) + (a - 1) * cosine + beta,
+    -2 * ((a - 1) + (a + 1) * cosine),
+    (a + 1) + (a - 1) * cosine - beta);
+}
+
+static inline DNEQCoefficients DNTFilter(int kind, double cutoff, double sampleRate) {
+  if (kind != 1 && kind != 2) return DNTIdentity();
+  cutoff = fmax(20, fmin(sampleRate * 0.45, cutoff));
+  const double omega = 2 * DN_EQ_PI * cutoff / sampleRate;
+  const double cosine = cos(omega), alpha = sin(omega) / sqrt(2);
+  const double edge = kind == 1 ? 1 - cosine : 1 + cosine;
+  return DNTNormalize(edge / 2, kind == 1 ? edge : -edge, edge / 2,
+    1 + alpha, -2 * cosine, 1 - alpha);
+}
+
+static inline double DNTResponseSquared(DNEQCoefficients c,
+                                         double cosine, double sine,
+                                         double cosine2, double sine2) {
+  const double nr = c.b0 + c.b1 * cosine + c.b2 * cosine2;
+  const double ni = c.b1 * sine + c.b2 * sine2;
+  const double dr = 1 + c.a1 * cosine + c.a2 * cosine2;
+  const double di = c.a1 * sine + c.a2 * sine2;
+  return (nr * nr + ni * ni) / fmax(1e-24, dr * dr + di * di);
+}
+
+static inline void DNTPrepare(DNTransitionDSP *dsp, double sampleRate) {
+  memset(dsp, 0, sizeof(*dsp));
+  dsp->sampleRate = isfinite(sampleRate) && sampleRate > 0 ? sampleRate : 48000;
+  dsp->preamp = dsp->targetPreamp = 1;
+  for (int band = 0; band <= DN_TRANSITION_BANDS; band++)
+    dsp->coefficients[band] = DNTIdentity();
+  for (int index = 0; index < DN_TRANSITION_PROBES; index++) {
+    const double frequency = 20 * pow(dsp->sampleRate * 0.45 / 20,
+      (double)index / (DN_TRANSITION_PROBES - 1));
+    const double omega = 2 * DN_EQ_PI * frequency / dsp->sampleRate;
+    dsp->probeCos[index] = cos(omega);
+    dsp->probeSin[index] = sin(omega);
+    dsp->probeCos2[index] = cos(2 * omega);
+    dsp->probeSin2[index] = sin(2 * omega);
+  }
+}
+
+static inline void DNTSetSettings(DNTransitionDSP *dsp,
+                                   const DNTransitionSettings *settings, int mode) {
+  const bool active = (mode == 1 || mode == 3) && settings &&
+    (settings->eqEnabled || settings->filterKind == 1 || settings->filterKind == 2);
+  if (settings) dsp->settings = *settings;
+  if (active && !dsp->active) {
+    memset(dsp->channels, 0, sizeof(dsp->channels));
+    dsp->step = 0;
+    dsp->preamp = 1;
+  }
+  dsp->active = active;
+}
+
+static inline void DNTBeginFrame(DNTransitionDSP *dsp, double mediaTime,
+                                  double start, double duration) {
+  if (!dsp->active) return;
+  const double elapsed = mediaTime - start;
+  dsp->wet = isfinite(elapsed) && isfinite(duration) && duration > 0
+    ? fmax(0, fmin(1, fmin(elapsed, duration - elapsed) / 0.015)) : 0;
+  if (dsp->step++ % 32 == 0) {
+    const double t = isfinite(mediaTime) && isfinite(start) && isfinite(duration) && duration > 0
+      ? fmax(0, fmin(1, (mediaTime - start) / duration)) : 0;
+    for (int band = 0; band < DN_TRANSITION_BANDS; band++) {
+      const double gain = dsp->settings.eqEnabled
+        ? DNCrossfadeCurveValue(&dsp->settings.eq[band], t) : 0;
+      const double safeGain = isfinite(gain) ? fmax(-24, fmin(24, gain)) : 0;
+      dsp->coefficients[band] = band == 1
+        ? DNEQMakePeaking(1000, dsp->sampleRate, safeGain)
+        : DNTShelf(band == 2, band == 0 ? 200 : 5000, dsp->sampleRate, safeGain);
+    }
+    const double cutoff = DNCrossfadeCurveValue(&dsp->settings.cutoff, t);
+    dsp->coefficients[DN_TRANSITION_FILTER_INDEX] = DNTFilter(
+      dsp->settings.filterKind, isfinite(cutoff) ? cutoff : 20000, dsp->sampleRate);
+
+    // The transition EQ is independent of the global EQ. Reserve headroom
+    // for the combined temporary response before processing its first sample.
+    double peakSquared = 1;
+    for (int probe = 0; probe < DN_TRANSITION_PROBES; probe++) {
+      double response = 1;
+      for (int band = 0; band <= DN_TRANSITION_BANDS; band++)
+        response *= DNTResponseSquared(dsp->coefficients[band],
+          dsp->probeCos[probe], dsp->probeSin[probe],
+          dsp->probeCos2[probe], dsp->probeSin2[probe]);
+      peakSquared = fmax(peakSquared, response);
+    }
+    dsp->targetPreamp = peakSquared > 1.0001 ? pow(10, -0.5 / 20) / sqrt(peakSquared) : 1;
+    if (dsp->step == 1 || dsp->targetPreamp < dsp->preamp)
+      dsp->preamp = dsp->targetPreamp;
+  }
+  // Recover slowly when the EQ becomes gentler; attenuation is immediate.
+  if (dsp->preamp < dsp->targetPreamp)
+    dsp->preamp += (dsp->targetPreamp - dsp->preamp) * 0.00025;
+}
+
+static inline float DNTProcessSample(DNTransitionDSP *dsp, unsigned int channel, float input) {
+  if (!dsp->active || channel >= DN_EQ_MAX_CHANNELS) return input;
+  if (!isfinite(input)) return 0;
+  double value = input * dsp->preamp;
+  for (int band = 0; band <= DN_TRANSITION_BANDS; band++) {
+    const DNEQCoefficients c = dsp->coefficients[band];
+    DNEQState *s = &dsp->channels[channel][band];
+    const double output = c.b0 * value + c.b1 * s->x1 + c.b2 * s->x2 - c.a1 * s->y1 - c.a2 * s->y2;
+    s->x2 = s->x1; s->x1 = value; s->y2 = s->y1; s->y1 = output;
+    value = output;
+  }
+  if (!isfinite(value)) {
+    memset(dsp->channels[channel], 0, sizeof(dsp->channels[channel]));
+    return 0;
+  }
+  // Enter and leave the temporary chain over 15 ms so a non-neutral endpoint
+  // can bypass cleanly without changing the persistent ten-band EQ.
+  return (float)fmax(-1, fmin(1, input + (value - input) * dsp->wet));
+}
+
+#endif
