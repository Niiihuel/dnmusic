+package expo.modules.audio
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.math.sqrt
+
+class AudioCrossfadeCurveTest {
+  @Test fun validatesEndpointsAndRejectsInvalidEnvelope() {
+    val outgoing = listOf(
+      CrossfadeVolumePoint(0.0, 1.0),
+      CrossfadeVolumePoint(0.5, 0.8),
+      CrossfadeVolumePoint(1.0, 0.0)
+    )
+    assertTrue(validCrossfadeCurve(outgoing, false))
+    assertFalse(validCrossfadeCurve(outgoing, true))
+    assertFalse(validCrossfadeCurve(outgoing + CrossfadeVolumePoint(1.0, 0.0), false))
+    assertFalse(validCrossfadeCurve(listOf(outgoing[0], CrossfadeVolumePoint(1.0, Double.NaN)), false))
+  }
+
+  @Test fun interpolatesCustomCurvesAndEqualPowerLaw() {
+    val incoming = listOf(
+      CrossfadeVolumePoint(0.0, 0.0),
+      CrossfadeVolumePoint(0.5, 0.2),
+      CrossfadeVolumePoint(1.0, 1.0)
+    )
+    assertEquals(0.1f, crossfadeValue(incoming, true, CrossfadeVolumeLaw.LINEAR, 0.25), 0.00001f)
+    assertEquals(1f, crossfadeValue(null, false, CrossfadeVolumeLaw.LINEAR, -1.0), 0.00001f)
+    assertEquals(0f, crossfadeValue(null, false, CrossfadeVolumeLaw.LINEAR, 2.0), 0.00001f)
+    assertEquals((sqrt(0.5)).toFloat(),
+      crossfadeValue(null, true, CrossfadeVolumeLaw.EQUAL_POWER, 0.5), 0.00001f)
+    assertEquals((sqrt(0.5)).toFloat(),
+      crossfadeValue(null, false, CrossfadeVolumeLaw.EQUAL_POWER, 0.5), 0.00001f)
+  }
+}
