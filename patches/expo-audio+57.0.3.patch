+class TransitionDspTest {
+  private fun curve(first: Double, last: Double = first) = listOf(
+    CrossfadeVolumePoint(0.0, first), CrossfadeVolumePoint(1.0, last)
+  )
+
+  private fun rms(frequency: Double, effect: TransitionDeckEffect?): Double {
+    val sampleRate = 48_000
+    val dsp = TransitionDsp(sampleRate, 1)
+    dsp.setConfig(effect)
+    var sum = 0.0
+    var count = 0
+    for (index in 0 until sampleRate) {
