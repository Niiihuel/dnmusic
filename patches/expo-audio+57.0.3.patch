+/** Media3 invokes this on the audio renderer thread before the AudioTrack.
+ * It deliberately rejects formats outside interleaved PCM16/float and never
+ * claims to have applied an effect to passthrough or offloaded audio. */
+@UnstableApi
+class TransitionPcmProcessor : BaseAudioProcessor() {
+  @Volatile internal var supportsEffects = false
+    private set
+  @Volatile private var requestedEffect: TransitionDeckEffect? = null
+  private var appliedEffect: TransitionDeckEffect? = null
+  private var dsp: TransitionDsp? = null
+  private var positionOffsetUs = 0L
+  private var frameIndex = 0L
+
+  internal fun arm(effect: TransitionDeckEffect?) { requestedEffect = effect }
+
+  override fun onConfigure(inputAudioFormat: AudioProcessor.AudioFormat): AudioProcessor.AudioFormat {
+    supportsEffects = inputAudioFormat.sampleRate > 0 && inputAudioFormat.channelCount in 1..8 &&
+      (inputAudioFormat.encoding == C.ENCODING_PCM_16BIT || inputAudioFormat.encoding == C.ENCODING_PCM_FLOAT)
+    return if (supportsEffects) inputAudioFormat else AudioProcessor.AudioFormat.NOT_SET
+  }
+
+  override fun onFlush(streamMetadata: AudioProcessor.StreamMetadata) {
+    positionOffsetUs = streamMetadata.positionOffsetUs
+    frameIndex = 0L
+    dsp = if (supportsEffects) TransitionDsp(inputAudioFormat.sampleRate, inputAudioFormat.channelCount) else null
+    appliedEffect = null
+  }
+
+  override fun onFlush() {
+    positionOffsetUs = 0L
+    frameIndex = 0L
+    dsp = if (supportsEffects) TransitionDsp(inputAudioFormat.sampleRate, inputAudioFormat.channelCount) else null
+    appliedEffect = null
+  }
+
+  override fun onReset() {
+    supportsEffects = false
+    requestedEffect = null
+    appliedEffect = null
+    dsp = null
+    frameIndex = 0L
+  }
+
+  override fun queueInput(inputBuffer: ByteBuffer) {
+    val processor = dsp ?: return
+    val next = requestedEffect
+    if (next !== appliedEffect) {
+      processor.setConfig(next)
+      appliedEffect = next
+    }
+    val frameBytes = inputAudioFormat.bytesPerFrame
+    val frames = inputBuffer.remaining() / frameBytes
+    val output = replaceOutputBuffer(frames * frameBytes)
+    inputBuffer.order(ByteOrder.LITTLE_ENDIAN)
+    output.order(ByteOrder.LITTLE_ENDIAN)
+    if (next == null) {
+      output.put(inputBuffer)
+    } else {
+      val channels = inputAudioFormat.channelCount
+      val floatPcm = inputAudioFormat.encoding == C.ENCODING_PCM_FLOAT
+      for (frame in 0 until frames) {
+        processor.beginFrame((positionOffsetUs + (frameIndex + frame) * 1_000_000L /
+          inputAudioFormat.sampleRate) / 1_000_000.0)
+        for (channel in 0 until channels) {
+          if (floatPcm) {
+            output.putFloat(processor.processSample(channel, inputBuffer.float))
+          } else {
+            val value = processor.processSample(channel, inputBuffer.short / 32768f)
+            output.putShort((value * 32768f).toInt().coerceIn(-32768, 32767).toShort())
+          }
+        }
+      }
+    }
+    frameIndex += frames
+    output.flip()
+  }
+}
