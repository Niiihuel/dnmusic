+/*
+ * Tokens de diseño de Dany.
+ *
+ * Criterio inspirado en Spotify: superficies neutras separadas por contraste de
+ * fondo (no por bordes) y UN solo acento, el blanco, que aparece únicamente en
+ * estados activos y acciones primarias — nunca rellenando áreas grandes.
+ *
+ * Valores en triplete RGB sin coma para que Tailwind pueda aplicar <alpha-value>.
+ *
+ * El tema por defecto es el oscuro; html[data-theme="light"] voltea los mismos
+ * nombres de token, así ningún componente necesita saber que existe un tema.
+ */
+
+:root {
+  /* Paleta completamente acromática — ver docs/DESIGN.md.
+     Las superficies se separan por luminancia, nunca por tono ni por bordes.
+     Escalonado tomado de Spotify: #121212 → #181818 → #1F1F1F. */
+  /* El lienzo detrás de los paneles: negro puro, para que la separación
+     entre paneles se lea sin necesidad de bordes. */
+  --color-canvas: 0 0 0;
+  --color-background: 18 18 18;
+  --color-foreground: 255 255 255;
+  --color-card: 24 24 24;
+  --color-card-foreground: 255 255 255;
+  --color-muted: 31 31 31;
+  --color-muted-foreground: 179 179 179;
+  /* El acento es el BLANCO: lo más brillante de la pantalla es la acción
+     principal. Solo en acciones primarias y estados activos — repartirlo le
+     saca la fuerza. */
+  --color-primary: 255 255 255;
+  --color-primary-foreground: 18 18 18;
+  --color-secondary: 31 31 31;
+  --color-secondary-foreground: 255 255 255;
+  /* Sin color: los errores se distinguen por redacción y posición. */
+  --color-destructive: 229 229 229;
+  --color-border: 77 77 77;
+  --color-ring: 255 255 255;
+}
+
+html[data-theme='light'] {
+  --color-canvas: 235 235 235;
+  --color-background: 255 255 255;
+  --color-foreground: 18 18 18;
+  --color-card: 245 245 245;
+  --color-card-foreground: 18 18 18;
+  --color-muted: 239 239 239;
+  --color-muted-foreground: 106 106 106;
+  --color-primary: 18 18 18;
+  --color-primary-foreground: 255 255 255;
+  --color-secondary: 239 239 239;
+  --color-secondary-foreground: 18 18 18;
+  --color-destructive: 42 42 42;
+  --color-border: 200 200 200;
+  --color-ring: 18 18 18;
+}
+
+/*
+ * ── Barra de desplazamiento propia ─────────────────────────────────────────
+ *
+ * La nativa de Chrome en Linux es una barra clara y ancha que sobre un fondo
+ * casi negro se lee como una franja blanca pegada al borde. Acá se reemplaza
+ * por uno de los grises del sistema.
