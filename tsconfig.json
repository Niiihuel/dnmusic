{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["expo/types", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "qrcode-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    // Electron y el servicio usan sus propios tsconfig y dependencias.
    "desktop",
    "server"
  ]
}
