{
  "expo": {
    "name": "dnmusic",
    "slug": "flora",
    "version": "1.15.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dnmusic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nihuel.dnmusic",
      "associatedDomains": [
        "applinks:dnmusic-app.vercel.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "dnmusic necesita tus fotos para poner tu foto de perfil y las ilustraciones que muestres en él."
      }
    },
    "android": {
      "package": "com.nihuel.dnmusic",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dnmusic-app.vercel.app",
              "pathPrefix": "/cancion"
            },
            {
              "scheme": "https",
              "host": "dnmusic-app.vercel.app",
              "pathPrefix": "/lista"
            },
            {
              "scheme": "https",
              "host": "dnmusic-app.vercel.app",
              "pathPrefix": "/jam"
            },
            {
              "scheme": "https",
              "host": "dnmusic-app.vercel.app",
              "pathPrefix": "/perfil"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "dnmusic",
      "shortName": "dnmusic",
      "display": "standalone",
      "themeColor": "#121212",
      "backgroundColor": "#121212",
      "startUrl": "/",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-dnmusic.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "dnmusic necesita tus fotos para poner tu foto de perfil y las ilustraciones que muestres.",
          "cameraPermission": false
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00b92a9e-b7f1-4c0f-b26d-62681d3236a1"
      }
    },
    "owner": "niihuel"
  }
}
