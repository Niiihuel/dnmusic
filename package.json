{
  "name": "dnmusic",
  "version": "1.17.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "start": "expo start",
    "dev": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export --platform web --clear && node scripts/inject-pwa.mjs dist",
    "start:railway": "node --import tsx scripts/serve-railway.ts",
    "motor": "node scripts/armar-motor.mjs",
    "typecheck": "tsc --noEmit",
    "ios:dev": "eas build --profile development --platform ios",
    "ios:preview": "eas build --profile preview --platform ios",
    "ios:release": "eas build --profile production --platform ios --auto-submit",
    "lint": "expo lint",
    "ios:build": "eas build --profile production --platform ios",
    "android:doctor": "node scripts/android-dev.mjs doctor",
    "android:run": "node scripts/android-dev.mjs run",
    "android:dev": "node scripts/android-dev.mjs start",
    "android:usb": "node scripts/android-dev.mjs reverse"
  },
  "dependencies": {
