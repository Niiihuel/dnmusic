{
  "name": "dany",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export --platform web && node scripts/inject-pwa.mjs dist",
    "typecheck": "tsc --noEmit",
    "ios:dev": "eas build --profile development --platform ios",
    "ios:preview": "eas build --profile preview --platform ios",
    "ios:release": "eas build --profile production --platform ios --auto-submit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "~57.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "~57.0.11",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.11",
    "expo-glass-effect": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "lucide-react-native": "^1.30.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.6",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  }
}
