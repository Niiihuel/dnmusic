{
  "name": "dnmusic-desktop",
  "version": "1.0.0",
  "description": "dnmusic para Windows y Linux",
  "author": "Nihuel",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "desktopName": "dnmusic.desktop",
  "scripts": {
    "build": "tsc",
    "traer-web": "node scripts/traer-web.mjs",
    "dev": "npm run build && electron .",
    "notas": "node scripts/notas-release.mjs",
    "empaquetar": "npm run build && npm run traer-web && npm run notas && electron-builder --publish never",
    "publicar": "npm run build && npm run traer-web && npm run notas && electron-builder --publish always",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "diagnostico:youtube": "npm run build && electron scripts/diagnostico-youtube.cjs",
    "comparar:youtube": "node scripts/comparar-diagnosticos.cjs"
  },
  "dependencies": {
    "bgutils-js": "^4.0.3",
    "electron-updater": "^6.8.9",
    "jsdom": "^28.1.0",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0"
  }
}
